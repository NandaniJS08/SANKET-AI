# ==============================================================================
# SANKET-AI Backend Environment Configuration Template
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Supabase PostgreSQL & Auth Connection
SUPABASE_URL=
SUPABASE_KEY=

# AI/ML Engine Integration Path
ML_ENGINE_PATH=../ai_engine

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ==============================================================================
# Institutional Demo Persona Passwords
# Required at startup — missing values will cause the server to refuse to start.
# Set to the actual Supabase Auth passwords for each provisioned persona account.
# NEVER hardcode real passwords here. Populate only in the active backend/.env.
# ==============================================================================
OFFICER_PASSWORD=
POLICYMAKER_PASSWORD=
ADMIN_PASSWORD=
